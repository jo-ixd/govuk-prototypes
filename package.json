{
  "name": "govuk-prototypes",
  "private": true,
  "workspaces": [
    "packages/*",
    "prototype-starter"
  ],
  "scripts": {
    "dev": "npm run dev -w prototype-starter",
    "build": "npm run build -w prototype-starter",
    "start": "npm run start -w prototype-starter",
    "lint": "eslint .",
    "typecheck": "npm run typecheck -w prototype-starter",
    "test": "vitest run",
    "format": "prettier -w .",
    "format:check": "prettier -c ."
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prettier": "^3.6.2",
    "typescript": "^5",
    "vitest": "^4.0.15"
  }
}
